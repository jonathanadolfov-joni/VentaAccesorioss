@model IEnumerable<VentaAccesorioss.Models.Marca>
@{ ViewData["Title"] = "Marcas"; }
<h2 class="titulo mb-4"> Marcas</h2>
<div class="row g-4">
@foreach (var m in Model)
{
    <div class="col-6 col-md-4 col-lg-3">
        <div class="card tarjeta-prod h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="avatar">@m.Nombre.Substring(0, 1).ToUpper()</div>
            <h5 class="m-0">@m.Nombre</h5>
        </div></div>
    </div>
}
</div>

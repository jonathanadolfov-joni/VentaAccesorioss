@model IEnumerable<VentaAccesorioss.Models.Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<h2 class="titulo mb-4">👤 Usuarios</h2>
<div class="row g-4">
@foreach (var u in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="card tarjeta-prod h-100"><div class="card-body d-flex align-items-center gap-3">
            <div class="avatar">@u.Nombre.Substring(0, 1).ToUpper()</div>
            <div>
                <h6 class="m-0">@u.Nombre</h6>
                <small class="text-muted">@u.Correo</small><br />
                <span class="badge badge-cat mt-1">@u.Rol</span>
            </div>
        </div></div>
    </div>
}
</div>
